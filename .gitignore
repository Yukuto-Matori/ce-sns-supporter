# This .gitignore file should be placed at the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio cache directory
.vs/



# Builds
*.apk
*.aab
*.unitypackage
*.app


# Packages
ce-shared-tools/
tmp/**

# Python のバイトコードキャッシュ。tools/python 実行のたびに再生成される
__pycache__/
*.py[cod]

# RunAI_Chat.sh が起動時に生成する軽量 TODO 概要
/.ce-shared-tools/todo-plan.active.md


# dotnet test artifacts (Celib-Core / Celib-Core.Tests)
obj/
bin/


# ローカル専用の環境変数 (git では管理しない)
.env
